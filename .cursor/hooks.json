{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node .cursor/hooks/session-start.mjs",
        "timeout": 10
      }
    ],
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/post-edit-checks.mjs",
        "timeout": 60
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/completed-gate.mjs",
        "loop_limit": 3
      }
    ]
  }
}
