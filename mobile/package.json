{
  "name": "zovus-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Zovus Android shell (Capacitor) — loads production WebView URL",
  "scripts": {
    "sync": "cap sync android",
    "copy": "cap copy android",
