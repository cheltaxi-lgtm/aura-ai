# =============================================================================
# Zovus production environment — copy to .env.local and fill in secrets
# =============================================================================

# --- Core (required) ---
DATABASE_URL=postgresql://auraai:CHANGE_ME@localhost:5432/auraai
AUTH_SECRET=change-me-to-random-32-char-secret-key
NEXT_PUBLIC_APP_URL=https://zovus.ru
COOKIE_SECURE=true

# --- LLM (required for chat/readings) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
LLM_CONCURRENCY_MAX=25
LLM_QUEUE_TIMEOUT_MS=120000

# --- Memory embeddings ---
MEMORY_EMBED_MODEL=baai/bge-m3
# Dedicated (cheaper/faster) model for background fact extraction from chat
# turns — structured JSON extraction, the main chat model is overkill for it.
# Falls back to the admin-configured chat model if unset.
MEMORY_EXTRACT_MODEL=openai/gpt-4o-mini

# --- Payments YooKassa (required for rune purchases) ---
# Webhook URL in YooKassa dashboard: https://zovus.ru/api/payment/webhook
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=

# --- reCAPTCHA v3 (required in production for registration) ---
RECAPTCHA_ENABLED=true
NEXT_PUBLIC_RECAPTCHA_ENABLED=true
RECAPTCHA_SECRET_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# --- Background jobs ---
# Header: x-cron-secret — endpoints /api/ritual/remind, /api/cron/event-reminders, /api/cron/daily-reading-remind
CRON_SECRET=

# --- Email (transactional + SMTP fallback) ---
# See hosting/MAIL-SETUP.md — DNS: ./hosting/setup-mail-dns-beget.sh
RESEND_API_KEY=
EMAIL_FROM=Zovus <noreply@zovus.ru>
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_SUPPORT=support@zovus.ru
MAIL_PRIVACY=privacy@zovus.ru
MAIL_CLAIMS=claims@zovus.ru
MAIL_ADMIN_NOTIFY=admin@zovus.ru

# --- Influencer registration (required in production) ---
INFLUENCER_REGISTER_SECRET=

# --- Admin seed (run once: node scripts/seed-admin.mjs) ---
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=Admin

# --- OAuth login (VK ID, Yandex) ---
# Callback URLs (register in each provider dashboard):
#   https://zovus.ru/api/auth/oauth/yandex/callback
#   https://zovus.ru/api/auth/oauth/vk/callback
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_PROTECTED_KEY=
VK_SERVICE_TOKEN=
VK_ANDROID_CLIENT_ID=
VK_ANDROID_CLIENT_SECRET=
VK_ANDROID_SERVICE_TOKEN=

# --- Yandex Metrika Management API (scripts/sync-metrika-goals.mjs) ---
# OAuth app: https://oauth.yandex.ru/ → API access → metrika:read + metrika:write
YANDEX_METRIKA_OAUTH_TOKEN=
YANDEX_METRIKA_CLIENT_ID=
YANDEX_METRIKA_CLIENT_SECRET=
YANDEX_METRIKA_COUNTER_ID=110138367

# --- Optional ---
DB_POOL_MAX=20
TRUST_PROXY=true
# DATABASE_SSL=require
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
# RECAPTCHA_ENABLED=false  # dev only — never in production
# DEBUG_LLM=false

# --- Android app release (Module A) ---
# ANDROID_KEYSTORE_PATH=/opt/secrets/zovus-release.jks
# ANDROID_KEYSTORE_PASSWORD=
# ANDROID_KEY_ALIAS=zovus
# ANDROID_KEY_PASSWORD=
# ANDROID_VERSION_CODE=1
# ANDROID_VERSION_NAME=1.0.0
# ANDROID_MIN_VERSION_CODE=1
# ANDROID_APK_URL=https://zovus.ru/releases/zovus-latest.apk
# NEXT_PUBLIC_ANDROID_APK_URL=https://zovus.ru/releases/zovus-latest.apk
# ANDROID_RELEASE_NOTES=Официальное приложение Zovus
# ANDROID_ASSETLINKS_SHA256=ABCDEF...  # colonless SHA-256 from scripts/print-android-cert-sha.mjs
# NEXT_PUBLIC_GITHUB_REPO=cheltaxi-lgtm/aura-ai
