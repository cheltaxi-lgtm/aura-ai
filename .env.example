# =============================================================================
# Zovus production environment — copy to .env.local and fill in secrets
# =============================================================================

# --- Core (required) ---
DATABASE_URL=postgresql://auraai:CHANGE_ME@localhost:5432/auraai
AUTH_SECRET=change-me-to-random-32-char-secret-key
NEXT_PUBLIC_APP_URL=https://zovus.ru
COOKIE_SECURE=true

# --- LLM (required for chat/readings) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
LLM_CONCURRENCY_MAX=25
LLM_QUEUE_TIMEOUT_MS=120000

# --- Memory embeddings ---
MEMORY_EMBED_MODEL=baai/bge-m3

# --- Payments YooKassa (required for rune purchases) ---
# Webhook URL in YooKassa dashboard: https://zovus.ru/api/payment/webhook
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=

# --- reCAPTCHA v3 (required in production for registration) ---
RECAPTCHA_ENABLED=true
NEXT_PUBLIC_RECAPTCHA_ENABLED=true
RECAPTCHA_SECRET_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# --- Background jobs ---
# Header: x-cron-secret — endpoints /api/ritual/remind, /api/cron/event-reminders
CRON_SECRET=

# --- Admin seed (run once: node scripts/seed-admin.mjs) ---
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=Admin

# --- Optional ---
DB_POOL_MAX=20
# RECAPTCHA_ENABLED=false  # dev only — never in production
# DEBUG_LLM=false
