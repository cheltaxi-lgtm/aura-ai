# =============================================================================
# Zovus production environment — copy to .env.local and fill in secrets
# =============================================================================

# --- Core (required) ---
DATABASE_URL=postgresql://auraai:CHANGE_ME@localhost:5432/auraai
AUTH_SECRET=change-me-to-random-32-char-secret-key
NEXT_PUBLIC_APP_URL=https://zovus.ru
COOKIE_SECURE=true
# Optional: Sentry error tracking (@sentry/nextjs). Leave unset to disable.
# Server/edge use SENTRY_DSN; browser prefers NEXT_PUBLIC_SENTRY_DSN (falls back to SENTRY_DSN at build time if inlined).
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# Optional: JSON POST webhook for reportError (Slack/Discord/etc.)
# ERROR_WEBHOOK_URL=

# --- LLM (required for chat/readings) ---
OPENROUTER_API_KEY=
# Optional: management key for account balance + per-model activity (openrouter.ai/settings/keys)
OPENROUTER_MANAGEMENT_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
LLM_CONCURRENCY_MAX=25
LLM_QUEUE_TIMEOUT_MS=120000

# --- Guest teaser short reading (POST /api/guest-triplet/teaser) ---
# Kill-switch: keep FALSE in prod until owner enables. Fallback = keyword meanings.
TEASER_LLM_ENABLED=false
TEASER_DAILY_BUDGET_CALLS=300
TEASER_MODEL=openai/gpt-4o-mini
TEASER_MIN_QUESTION_LENGTH=15
# Owner disable thresholds (ops): day calls≥300 OR day out-tokens≥60k OR hour rate-limited≥80

# --- Memory embeddings ---
MEMORY_EMBED_MODEL=baai/bge-m3
# Dedicated (cheaper/faster) model for background fact extraction from chat
# turns — structured JSON extraction, the main chat model is overkill for it.
# Falls back to the admin-configured chat model if unset.
MEMORY_EXTRACT_MODEL=openai/gpt-4o-mini

# --- Payments YooKassa (required for rune purchases) ---
# Webhook URL in YooKassa dashboard: https://zovus.ru/api/payment/webhook
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=

# --- reCAPTCHA v3 (required in production for registration) ---
RECAPTCHA_ENABLED=true
NEXT_PUBLIC_RECAPTCHA_ENABLED=true
RECAPTCHA_SECRET_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# --- Background jobs ---
# Header: x-cron-secret — endpoints /api/ritual/remind, /api/cron/event-reminders,
# /api/cron/daily-reading-remind, /api/cron/guest-resume-expire, …
CRON_SECRET=

# --- Email (transactional + SMTP fallback) ---
# See hosting/MAIL-SETUP.md — DNS: ./hosting/setup-mail-dns-beget.sh
RESEND_API_KEY=
EMAIL_FROM=Zovus <noreply@zovus.ru>
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_SUPPORT=support@zovus.ru
MAIL_PRIVACY=privacy@zovus.ru
MAIL_CLAIMS=claims@zovus.ru
MAIL_ADMIN_NOTIFY=admin@zovus.ru

# --- Influencer registration (required in production) ---
INFLUENCER_REGISTER_SECRET=

# --- Admin seed (run once: node scripts/seed-admin.mjs) ---
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=Admin

# --- OAuth login (VK ID, Yandex) ---
# Callback URLs (register in each provider dashboard):
#   https://zovus.ru/api/auth/oauth/yandex/callback
#   https://zovus.ru/api/auth/oauth/vk/callback
# Staging: add EXTRA redirects for STAGING_APP_URL (do not remove production):
#   {STAGING_APP_URL}/api/auth/oauth/yandex/callback
#   {STAGING_APP_URL}/api/auth/oauth/vk/callback
# See docs/staging-guest-triplet-resume.md
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_PROTECTED_KEY=

# Telegram bot channel + account bind (NOT Login Widget / «Войти через Telegram» — 149-FZ art.8 p.10).
# Bot may create a Zovus shell account after in-bot age+offer consent (synthetic email + TG bind).
# Login Widget / session-from-Telegram HMAC remain disabled in production.
# Mini App: ONE Main Mini App shell https://zovus.ru/tg (menu web_app only).
# Bot CTAs use t.me/<bot>?startapp=… — do not stack multiple web_app panels.
# Ops (BotFather, required once):
#   1) Domain / Configure Mini App → zovus.ru
#   2) Main Mini App URL → https://zovus.ru/tg
#   3) TELEGRAM_BOT_TOKEN on the site MUST match the bot token (HMAC for initData)
#   4) HTTPS + no frame-blocking for full-page WebApp (usually ok)
# Telegram Stars rune packs in the bot (~₽ per Star for package pricing; site keeps YooKassa):
# TELEGRAM_STARS_RUB_PER_STAR=2
# TELEGRAM_BOT_TOKEN=
# NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=zovus_card_bot
# TELEGRAM_AUTH_MAX_AGE_SEC=86400
# TELEGRAM_AUTH_LOGIN_ENABLED=  # never set in production; local debug only
# Bot internal API (site ↔ telegram-bot, shared secret)
# BOT_INTERNAL_BASE_URL=http://127.0.0.1:8787
# BOT_INTERNAL_SECRET=
# Bot also calls site at SITE_INTERNAL_BASE_URL (configured in telegram-bot/.env)

VK_SERVICE_TOKEN=
VK_ANDROID_CLIENT_ID=
VK_ANDROID_CLIENT_SECRET=
VK_ANDROID_SERVICE_TOKEN=

# --- Yandex Metrika Management API (scripts/sync-metrika-goals.mjs) ---
# OAuth app: https://oauth.yandex.ru/ → API access → metrika:read + metrika:write
YANDEX_METRIKA_OAUTH_TOKEN=
YANDEX_METRIKA_CLIENT_ID=
YANDEX_METRIKA_CLIENT_SECRET=
YANDEX_METRIKA_COUNTER_ID=110138367

# --- Ads Autopilot (config/ads + scripts/ads-verify.ts) ---
# OAuth app name: "Zovus Ads Autopilot" — scopes: Direct manage, Metrika read+offline conversions,
# Webmaster read, Wordstat. Never commit real tokens.
ADS_DIRECT_TOKEN=
ADS_DIRECT_REFRESH_TOKEN=
ADS_DIRECT_CLIENT_ID=
ADS_DIRECT_CLIENT_SECRET=
ADS_DIRECT_LOGIN=
# 1 = sandbox endpoint; 0 = production
ADS_DIRECT_SANDBOX=1
METRIKA_COUNTER_ID=110138367
METRIKA_TOKEN=
# Ads also accepts YANDEX_METRIKA_OAUTH_TOKEN / YANDEX_METRIKA_COUNTER_ID as fallbacks
WEBMASTER_TOKEN=
# Host id like https:zovus.ru:443 from Webmaster API (default in code: https:zovus.ru:443)
# If WEBMASTER_TOKEN empty, ads reuses Metrika/Direct OAuth when it has webmaster scopes
WEBMASTER_HOST_ID=https:zovus.ru:443
WORDSTAT_TOKEN=
# Numeric Metrika goal IDs (must exist in counter).
# Primary optimization: REGISTRATION + FIRST_RUNE_SPEND / FIRST_PAYMENT.
# Guest spread / claim are diagnostic only — not bid targets.
ADS_GOAL_GUEST_SPREAD_START=
ADS_GOAL_REGISTRATION=
ADS_GOAL_CLAIM=
ADS_GOAL_FIRST_RUNE_SPEND=
ADS_GOAL_FIRST_PAYMENT=
# Module flags (DB ads.config is source of truth; env overrides enabled)
ADS_ENABLED=false
# Admin UI + source sync without public beacon (default on via ads.config)
# ADS_OBSERVE=true
ADS_RULES_MODE=dry_run
# ADS_AUTOPILOT_WRITE=0
# ADS_ALLOW_DIRECT_WRITE=0
# ADS_DATABASE_URL=   # optional isolate; falls back to DATABASE_URL

# --- Zovus Pro (practitioner CRM) — keep false until S1 ---
PRO_MODULE_ENABLED=false
# PRO_ALLOWLIST_USER_IDS=
PRO_AI_ENABLED=false
PRO_BILLING_MODE=shadow
PRO_DELIVERY_ENABLED=false
PRO_DIALOG_MODE_MAX=b
PRO_PORTAL_ENABLED=false
PRO_FOLLOWUP_ENABLED=false
PRO_TRANSCRIPTS_ENABLED=false
PRO_VISION_ENABLED=false
PRO_TTS_ENABLED=false
PRO_MAX_CASES_PER_DAY=50
PRO_MAX_CLIENTS=200
# Do not disable — product safety invariant
PRO_CRISIS_GATE_ENABLED=true
# PRO_DATABASE_URL=   # optional isolate; falls back to DATABASE_URL

# --- Optional ---
DB_POOL_MAX=20
TRUST_PROXY=true
# DATABASE_SSL=require
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
# RECAPTCHA_ENABLED=false  # dev only — never in production
# DEBUG_LLM=false

# --- Android app release (Module A) ---
# ANDROID_KEYSTORE_PATH=/opt/secrets/zovus-release.jks
# ANDROID_KEYSTORE_PASSWORD=
# ANDROID_KEY_ALIAS=zovus
# ANDROID_KEY_PASSWORD=
# ANDROID_VERSION_CODE=1
# ANDROID_VERSION_NAME=1.0.0
# ANDROID_MIN_VERSION_CODE=1
# ANDROID_APK_URL=https://zovus.ru/releases/zovus-latest.apk
# NEXT_PUBLIC_ANDROID_APK_URL=https://zovus.ru/releases/zovus-latest.apk
# ANDROID_RELEASE_NOTES=Официальное приложение Zovus
# ANDROID_ASSETLINKS_SHA256=ABCDEF...  # colonless SHA-256 from scripts/print-android-cert-sha.mjs
# NEXT_PUBLIC_GITHUB_REPO=cheltaxi-lgtm/aura-ai
