# Database
DATABASE_URL=postgresql://auraai:auraai_secret@localhost:5432/auraai

# Auth
AUTH_SECRET=change-me-to-random-32-char-secret-key

# LLM providers
OPENROUTER_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Long-term memory — embeddings + fact extraction via OpenRouter.
# Fact extraction reuses the admin chat model (DeepSeek). Embeddings use the
# model below (bge-m3, 1024-dim, multilingual). Both reuse OPENROUTER_API_KEY.
MEMORY_EMBED_MODEL=baai/bge-m3

# Payments
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=

# Background crons (proactive reminders). Shared secret sent as the
# `x-cron-secret` header to /api/ritual/remind and /api/cron/event-reminders.
# Generated automatically on the VM if unset; set manually for local testing.
CRON_SECRET=
