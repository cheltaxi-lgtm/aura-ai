TELEGRAM_BOT_TOKEN=
ZOVUS_SITE_URL=https://zovus.ru
BOT_CTA_TARGET_URL=https://zovus.ru
# Mini App: site buttons open {ZOVUS_SITE_URL}/tg?to=… inside Telegram.
# BotFather → Domain / Configure Mini App → zovus.ru
# Site TELEGRAM_BOT_TOKEN must be the same token (initData HMAC).
# Public URL of this bot HTTP service (for tracked CTA). Optional.
# BOT_PUBLIC_BASE_URL=https://bot.example.com

BOT_MODE=polling
BOT_HTTP_ALWAYS=true
BOT_WEBHOOK_PORT=8787
# TELEGRAM_WEBHOOK_URL=
# TELEGRAM_WEBHOOK_SECRET=

BOT_TZ=Europe/Moscow
BOT_ENABLED=true
BOT_DAY_CARD_ENABLED=true
BOT_REMINDERS_ENABLED=true
BOT_RITUAL_REVEAL_ENABLED=true
BOT_TTS_ENABLED=true
BOT_LLM_ENABLED=true
BOT_SHARE_CARD_ENABLED=true
BOT_WEEKLY_DIGEST_ENABLED=false

# Legacy local-only daily limit (unused when BOT_REQUIRE_SITE_ACCOUNT=true)
BOT_TRIPLET_DAILY_LIMIT=1
BOT_LLM_DAILY_CAP=20
BOT_TTS_DAILY_CAP=10
BOT_CONSENT_VERSION=2026-07-1
BOT_USERNAME=zovus_card_bot
# BOT_ADMIN_CHAT_ID=

# Deck path (default: assets/decks/tarot-veronika inside this package)
# BOT_DECK_PATH=
# BOT_SKIP_ASSET_CHECK=false
# BOT_PLAIN_TOKEN_PREFIX_LEN=6
# Guest tg_receipt TTL hours (default 168 = 7 days)
# BOT_SESSION_TTL_HOURS=168
# Shared secret for site ↔ bot internal API
# BOT_INTERNAL_SECRET=
# Site thin-client base (loopback next to aura-ai.service)
SITE_INTERNAL_BASE_URL=http://127.0.0.1:3000
BOT_REQUIRE_SITE_ACCOUNT=true


# OPENROUTER_API_KEY=
# BOT_TEASER_MODEL=openai/gpt-4o-mini
# BOT_TTS_API_KEY=
# BOT_TTS_MODEL=openai/gpt-4o-mini-tts
# BOT_TTS_VOICE=nova
