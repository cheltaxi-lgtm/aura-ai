# Copy to .env.test (gitignored) for local invariant DB tests.
#
# Raise a local Postgres (repo docker-compose):
#   docker compose up -d postgres
#   docker exec auraai-postgres psql -U auraai -d postgres -c "CREATE DATABASE auraai_test;"
#   docker exec -i auraai-postgres psql -U auraai -d auraai_test < src/lib/schema.sql
#
# The vitest harness (tests/invariants/db/setup.ts) also bootstraps schema.sql
# + schema_migrations ledger when sessions is missing, then runs npm migrate.
#
# MUST be a dedicated database — never prod / beget / zovus.ru, and never equal
# to DATABASE_URL from .env.local.

TEST_DATABASE_URL=postgresql://auraai:auraai_secret@localhost:5432/auraai_test
