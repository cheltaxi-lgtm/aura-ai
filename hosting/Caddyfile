www.zovus.ru {
	redir https://zovus.ru{uri} permanent
}

zovus.ru {
	encode gzip
	# Preserve public host for Next redirects (otherwise Location becomes localhost:3000
	# and the Android WebView opens the system browser).
	reverse_proxy 127.0.0.1:3000 {
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
	}
}
