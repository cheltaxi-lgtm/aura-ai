# Shared env keys copied from .env.local → .env.async-jobs.
# Single source of truth: add a key here when BOTH aura-ai and aura-ai-async-jobs need it.
# Required keys (DATABASE_URL, ASYNC_JOB_WORKER_SECRET) are always written by sync-async-jobs-env.sh.
#
# Format: one KEY per line. Lines starting with # and blanks are ignored.

# Worker tuning
ASYNC_JOB_POLL_MS
ASYNC_JOB_CONCURRENCY
ASYNC_JOB_REQUEST_TIMEOUT_MS
ASYNC_JOB_STALE_RUNNING_MS
ASYNC_JOB_WATCHDOG_MS
ASYNC_JOB_HEARTBEAT_MS
ASYNC_JOB_TIMEOUT_GRACE_MS
ASYNC_JOB_KINDS
ASYNC_REPORT_CONCURRENCY
ASYNC_REPORT_INPROCESS
HD_PIPELINE_CONCURRENCY
HD_PIPELINE_LLM_EDITOR
HD_MIN_SECTION_CHARS
DB_POOL_MAX_WORKER
DB_STATEMENT_TIMEOUT_MS
REPORT_JOB_RETRY_ENABLED

# LLM concurrency (worker uses report pool when in-process)
LLM_CONCURRENCY_MAX
LLM_INTERACTIVE_CONCURRENCY_MAX
LLM_REPORT_CONCURRENCY_MAX
LLM_BACKGROUND_CONCURRENCY_MAX
LLM_QUEUE_TIMEOUT_MS

# OpenRouter — MUST include HTTPS proxy (Sweden). Direct from Beget times out.
OPENROUTER_API_KEY
OPENROUTER_HTTPS_PROXY
# Live model pricing (report cost accounting)
OPENROUTER_USD_RUB
OPENROUTER_PRICING_TTL_MS

# Auth — in-process runners call Next route handlers that sign session/auth cookies.
AUTH_SECRET

# Pro module — in-process pro_premium_report hits requireProEnabled() / PRO_AI_ENABLED.
PRO_MODULE_ENABLED
PRO_AI_ENABLED
PRO_BILLING_MODE

# Report-ready deliveries — worker sends in-app/email/Telegram notifications.
REPORT_BACKGROUND_DELIVERY_ENABLED
REPORT_READY_TELEGRAM_ENABLED
NEXT_PUBLIC_APP_URL
RESEND_API_KEY
SMTP_HOST
SMTP_PORT
SMTP_SECURE
SMTP_USER
SMTP_PASS
EMAIL_FROM
BOT_INTERNAL_BASE_URL
BOT_INTERNAL_SECRET
