    "verify:memory-policy": "npx tsx scripts/verify-memory-policy.mjs",
    "verify:memory-lifecycle": "npx tsx scripts/verify-memory-lifecycle.mjs",
    "verify:memory-adversarial": "npx tsx scripts/verify-memory-adversarial.mjs",
    "verify:memory-analytics": "node scripts/verify-memory-analytics.mjs",
