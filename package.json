    "celestine": "^0.2.1",
    "framer-motion": "^11.15.0",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "jose": "^5.9.6",
    "lucide-react": "^0.468.0",
    "natalengine": "^1.6.0",
    "next": "^15.1.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
