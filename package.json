    "verify:module-a": "node scripts/verify-module-a.mjs",
    "verify:app-shell": "node scripts/verify-app-shell.mjs",
    "verify:android-release": "node scripts/verify-android-release.mjs",
    "repair:android-release": "node scripts/verify-android-release.mjs --repair",
