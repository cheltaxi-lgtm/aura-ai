{
  "name": "aura-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 50",
    "build:decks": "node scripts/build-decks.mjs",
    "fix:deck-cards": "node scripts/fix-deck-cards-targeted.mjs",
    "normalize:deck-cards": "node scripts/deck-card-normalize.mjs",
    "verify:photo-aliases": "npx tsx scripts/verify-photo-aliases.mjs",
    "generate:deck-backs": "node scripts/deck-back-art.mjs",
    "generate:avatars": "node scripts/generate-master-avatars.mjs",
    "verify:deck-images": "node scripts/verify-deck-images.mjs",
    "verify:guardrails": "node scripts/verify-guardrails.mjs",
    "verify:chat-quality": "npx tsx scripts/verify-chat-quality.mjs",
    "migrate": "node scripts/migrate.mjs",
    "migrate:status": "node scripts/migrate.mjs --status",
    "test:memory": "tsx scripts/memory-smoke-test.ts",
    "test:recaptcha": "tsx scripts/verify-recaptcha.ts",
    "test:spreads": "tsx scripts/verify-spread-registry.ts && tsx scripts/verify-spread-source-audit.ts",
    "test": "npm run test:spreads && npm run verify:chat-quality && npm run verify:memory-policy && npm run verify:guardrails",
    "verify:memory-policy": "npx tsx scripts/verify-memory-policy.mjs",
    "maintenance:memory": "node scripts/memory-maintenance.mjs",
    "predeploy:check": "npm run test && npm run build"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "framer-motion": "^11.15.0",
    "html2canvas": "^1.4.1",
    "jose": "^5.9.6",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "postcss": "^8.4.49",
    "sharp": "^0.35.1",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2"
  }
}
