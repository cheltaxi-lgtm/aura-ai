    "verify:destiny-matrix-invariants": "npx tsx scripts/verify-destiny-matrix-invariants.mjs",
    "verify:matrix-sectioned": "npx tsx scripts/verify-matrix-sectioned.mjs",
    "verify:matrix-calc-drift": "npx tsx scripts/verify-matrix-calc-drift.mjs",
    "verify:natal-chart": "npx tsx scripts/verify-natal-chart.mjs && node scripts/verify-natal-backend.mjs",
